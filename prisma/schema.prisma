// schema.prisma
// Changes from original:
//   1. Added MappingTemplate model (saves column mappings per user)
//   2. Added @@unique([userId, name]) to Class   — needed for import upsert
//   3. Added @@unique([name, classId]) to Student — needed for import upsert
//   4. Added @@unique([name, classId]) to Assessment — needed for import upsert
//   5. Added mappingTemplates relation to User

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Teachers / Educators
model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  password           String
  email              String?
  role               String              @default("Teacher")
  isPremium          Boolean             @default(false)
  resetToken         String?
  resetTokenExpiry   DateTime?
  classes            Class[]
  notes              StudentNote[]
  mappingTemplates   MappingTemplate[]   // NEW
  createdAt          DateTime            @default(now())
}

// 2. Subjects / Classrooms
model Class {
  id          String       @id @default(uuid())
  name        String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  students    Student[]
  assessments Assessment[]
  createdAt   DateTime     @default(now())

  @@unique([userId, name])  // NEW — allows upsert by user + subject name
}

// 3. Students
model Student {
  id         String   @id @default(uuid())
  externalId String?  // Made optional — not all files have an ID column
  name       String
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  scores     Score[]
  createdAt  DateTime @default(now())

  @@unique([name, classId])        // NEW — allows upsert by name + class
  @@unique([externalId, classId])  // KEPT — original unique constraint
}

// 4. Tests / Assessments
model Assessment {
  id        String   @id @default(uuid())
  name      String
  date      String?
  topic     String?
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  scores    Score[]
  createdAt DateTime @default(now())

  @@unique([name, classId])  // NEW — allows upsert by assessment name + class
}

// 5. Individual Grades
model Score {
  id           String     @id @default(uuid())
  score        Float
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([studentId, assessmentId])
}

// 6. Teacher notes + goals per student (unchanged)
model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String
  note      String   @default("")
  goal      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, studentId])
}

// 7. NEW — Saved column mapping templates
// When a teacher uploads a file and confirms the mapping, they can save it.
// The next time a file with identical headers is uploaded, the mapping is
// applied automatically with no manual review needed.
model MappingTemplate {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String                    // e.g. "SIMS Export", "Canvas Gradebook"
  sourceFingerprint String                    // MD5 hash of sorted normalised headers
  mappings          Json                      // { student_name: "Name", grade: "Score", ... }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, sourceFingerprint])       // one template per unique header layout per user
}
